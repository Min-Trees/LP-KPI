{
  "name": "kpi-management-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hệ thống quản lý KPI nội bộ - React + Firebase",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "seed": "tsx scripts/seed.ts",
    "seed:accounts": "node scripts/seedAccounts.mjs",
    "create-admin": "node node_modules/tsx/dist/cli.mjs scripts/create-admin.ts",
    "seed:kpi": "node node_modules/tsx/dist/cli.mjs scripts/seed-kpi.ts",
    "seed:employees": "node node_modules/tsx/dist/cli.mjs scripts/seed-employees.ts",
    "delete:employees": "node node_modules/tsx/dist/cli.mjs scripts/delete-employees.ts",
    "api": "node server/api-server.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.59.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "express": "^4.22.2",
    "firebase": "^11.0.2",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^14.2.0",
    "postcss": "^8.4.49",
    "source-map": "^0.8.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
